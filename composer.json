{
    "name": "inupress/menus",
    "description": "Site navigation for Inupress: menus built from pages and custom links",
    "type": "inupress-plugin",
    "keywords": ["inupress", "inupress-plugin"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inupress/contracts": "^0.1",
        "inupress/core": "^0.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Inupress\\Menus\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Inupress\\Menus\\MenusServiceProvider"
            ]
        }
    }
}
